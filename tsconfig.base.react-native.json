{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-native",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "preserve",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"moduleSuffixes": ["", ".ios", ".android", ".windows", ".macos", ".web", ".native"],
		"target": "esnext",
		"types": [
			// in project references
			// it will fail without this
			// Even this custom type has already declared in specific projects
			"react-native-web"
		]
	}
}
